# The background work: the outbox, the mail, and the workers of the optional modules that are on.
# Install as /etc/systemd/system/vumlo-worker.service. Same layout as vumlo-core.service.

[Unit]
Description=Vumlo worker (outbox, mail, module workers)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=vumlo
Group=vumlo
Environment=VUMLO_CONFIG=/etc/vumlo/vumlo.toml
EnvironmentFile=/etc/vumlo/vumlo.env
# Uploaded files (ADR-0069). StateDirectory creates /var/lib/vumlo, owned by `vumlo` and writable under
# ProtectSystem=strict; core and worker share it. The variable overrides `files.path` of vumlo.toml,
# whose default (`files` beside the toml, in read-only /etc) is not writable here.
StateDirectory=vumlo
Environment=VUMLO__FILES__PATH=/var/lib/vumlo/files
ExecStart=/opt/vumlo/bin/vumlo-server worker
Restart=on-failure
RestartSec=3
# If [mail.transport] is kind = "file", the directory it writes to needs:
# ReadWritePaths=/var/lib/vumlo/mail

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=multi-user.target
