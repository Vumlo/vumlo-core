# Caddy in front of Vumlo: the web app and the API under one origin, with TLS from Let's Encrypt.
# Install it as /etc/caddy/Caddyfile (or import it) and set the domain:
#   VUMLO_DOMAIN=lms.example.edu
# The same origin goes in vumlo.toml as server.public_origin = "https://lms.example.edu", and
# server.client_ip_header = "x-real-ip" so the login limits see the client and not Caddy.

{$VUMLO_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Plugin tabs (ADR-0066). The web app frames only the addresses the core returns and puts each in a
	# sandbox, and sends no Content-Security-Policy of its own. To have the browser also refuse every other
	# frame source, add one here: 'self', YouTube and Vimeo (the videos of lectures), and the origins you
	# installed plugins from. A new plugin means a new line here.
	#
	#   header Content-Security-Policy "frame-src 'self' https://www.youtube-nocookie.com https://player.vimeo.com https://tools.example.edu"

	# The API: the core, which sees the client address in X-Real-IP. header_up replaces whatever the
	# client sent, so the header cannot be forged.
	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else is the web app.
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
