# The secrets of a Vumlo installation. Copy to .env (`vumlo-cli init` writes this file as
# .env.example), fill it in, and keep it readable by its owner only: chmod 600 .env
# `vumlo-cli doctor` fails while the file is readable by anyone else.
#
# These never go in vumlo.toml; the server and `vumlo-cli config check` refuse them there.
# Variables already set in the environment win over this file.

# PostgreSQL. Required.
DATABASE_URL=postgres://vumlo:change-me@localhost:5432/vumlo

# Sign-in with Google (only with [auth.google] in vumlo.toml).
# VUMLO__AUTH__GOOGLE__CLIENT_SECRET=

# SMTP relay password (only with a [mail.transport] of kind "smtp" that needs one).
# VUMLO__MAIL__TRANSPORT__PASSWORD=
