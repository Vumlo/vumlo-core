# The web app, built from what `vumlo-cli brand apply` generated (.vumlo/generated/): run
# `./vumlo brand apply` before building this image, and again whenever vumlo.toml changes.
#
# Build from the repository root:
#   docker build -f deploy/Dockerfile.web -t vumlo-web .

FROM node:24-slim AS build
WORKDIR /src
COPY web/package.json web/package-lock.json web/.npmrc ./web/
RUN cd web && npm ci
COPY web ./web
# The only configuration the web build reads (ADR-0054).
COPY .vumlo/generated ./.vumlo/generated
# Where the web app reaches the core. Next.js bakes the rewrite of /api/v1 in at build time.
ARG VUMLO_API_ORIGIN=http://core:8080
ENV VUMLO_API_ORIGIN=${VUMLO_API_ORIGIN}
RUN cd web && npm run build
# The mock API is for `dev:mock` only: its service worker and sample plugin page are not served, and the build fails
# if the browser bundle carries a sample account, the sample password or the worker.
RUN cd web && rm -f public/mockServiceWorker.js && rm -rf public/mock-plugin \
    && ! grep -rIlE "northfield\.edu|correct horse|setupWorker" .next/static

FROM node:24-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /src/web/package.json ./package.json
COPY --from=build /src/web/next.config.ts ./next.config.ts
COPY --from=build /src/web/node_modules ./node_modules
COPY --from=build /src/web/public ./public
COPY --from=build /src/web/.next ./.next
USER node
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
