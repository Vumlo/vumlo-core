  "query": "UPDATE teaching.courses\n           SET title = COALESCE($2, title),\n               term_id = CASE WHEN $3 THEN $4 ELSE term_id END,\n               updated_at = now()\n           WHERE id = $1\n           RETURNING id, kind AS \"kind: CourseKind\", title,\n                     status AS \"status: CourseStatus\", owner_id, term_id, created_at",
