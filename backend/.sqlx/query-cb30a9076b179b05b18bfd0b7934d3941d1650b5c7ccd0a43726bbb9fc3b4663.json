  "query": "SELECT id AS \"id!\", course_id AS \"course_id!\", deleted_at AS \"deleted_at!\"\n           FROM teaching.tombstone_list\n           WHERE kind = $1\n             AND ($2::uuid[] IS NULL OR course_id = ANY($2))\n             AND deleted_at >= $3\n             AND ($4::timestamptz IS NULL OR (deleted_at, id) > ($4, $5))\n           ORDER BY deleted_at, id\n           LIMIT $6",
