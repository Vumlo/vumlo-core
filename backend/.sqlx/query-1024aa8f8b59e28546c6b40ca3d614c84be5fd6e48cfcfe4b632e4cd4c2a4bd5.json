  "query": "SELECT user_id, count(*) AS \"count!\",\n                  EXTRACT(EPOCH FROM (now() - min(created_at)))::float8 AS \"age!\"\n           FROM mail.messages\n           WHERE plugin_id IS NOT NULL AND user_id = ANY($1)\n             AND created_at > now() - make_interval(secs => $2)\n           GROUP BY user_id",
