# eslint-config-next 14 asks for eslint 8 or older and the project uses eslint 10. pnpm (the package
# manager of web/AGENTS.md) treats that as a warning; npm refuses to install. This makes `npm ci`
# behave like pnpm here, for the Docker image, CI and `vumlo-cli build web`. It hides the mismatch,
# it does not fix it: `pnpm lint` does not run until eslint and eslint-config-next agree, which is a
# version change and needs an ADR (web/AGENTS.md).
legacy-peer-deps=true
